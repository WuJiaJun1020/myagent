{
  "name": "pi-desktop-client",
  "version": "0.1.1",
  "private": true,
  "description": "A desktop Agent workspace powered by Pi RPC mode",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/main/index.cjs && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/preload/index.cjs",
    "dev": "npm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env PI_CLIENT_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run build:main && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:renderer": "node scripts/verify-renderer.cjs",
    "dist:win": "npm run build && npm run verify:renderer && electron-builder --win portable --x64",
    "verify:package": "node scripts/verify-packaged-runtime.cjs --runtime-only",
    "verify:portable": "node scripts/verify-packaged-runtime.cjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "file:../pi-agent/packages/coding-agent",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "^3.14.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.9",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.local.pidesktop",
    "productName": "Pi Desktop",
    "asar": true,
    "asarUnpack": [
      "node_modules/@earendil-works/pi-coding-agent/**/*",
      "node_modules/**/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Pi-Desktop-${version}-${arch}.${ext}"
    }
  }
}
