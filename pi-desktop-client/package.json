{
  "name": "pi-desktop-client",
  "version": "0.6.0",
  "private": true,
  "description": "A desktop Agent workspace powered by Pi RPC mode",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --external:node-pty --external:@lancedb/lancedb --external:mammoth --external:pdf-parse --outfile=dist/main/index.cjs && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/preload/index.cjs",
    "dev": "npm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env PI_CLIENT_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run build:main && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:renderer": "node scripts/verify-renderer.cjs",
    "verify:pty": "electron scripts/verify-pty.cjs",
    "prepare:python:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-python-runtime.ps1",
    "dist:win": "npm run prepare:python:win && npm run build && npm run verify:renderer && electron-builder --win portable --x64",
    "dist:win:setup": "npm run prepare:python:win && npm run build && npm run verify:renderer && electron-builder --win nsis --x64",
    "verify:package": "node scripts/verify-packaged-runtime.cjs --runtime-only",
    "verify:portable": "node scripts/verify-packaged-runtime.cjs"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@earendil-works/pi-coding-agent": "file:../pi-agent/packages/coding-agent",
    "@lancedb/lancedb": "^0.39.0",
    "@langchain/langgraph": "^1.4.17",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "^3.14.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "mammoth": "^1.12.3",
    "node-pty": "^1.1.0",
    "pdf-parse": "^2.4.5",
    "prismjs": "^1.30.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/lxgw-wenkai": "^5.3.0",
    "@fontsource/maple-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.9",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.local.pidesktop",
    "productName": "Pi Desktop",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@earendil-works/pi-coding-agent/**/*",
      "node_modules/**/*.node"
    ],
    "extraResources": [
      {
        "from": "resources/interview-question-bank",
        "to": "interview-question-bank",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/algorithm-practice",
        "to": "algorithm-practice",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@fontsource-variable/noto-sans-sc/LICENSE",
        "to": "licenses/Noto-Sans-SC-OFL.txt"
      },
      {
        "from": "node_modules/@fontsource/lxgw-wenkai/LICENSE",
        "to": "licenses/LXGW-WenKai-OFL.txt"
      },
      {
        "from": "node_modules/@fontsource-variable/jetbrains-mono/LICENSE",
        "to": "licenses/JetBrains-Mono-OFL.txt"
      },
      {
        "from": "node_modules/@fontsource/maple-mono/LICENSE",
        "to": "licenses/Maple-Mono-OFL.txt"
      },
      {
        "from": "node_modules/@lancedb/lancedb/license_header.txt",
        "to": "licenses/LanceDB-Apache-2.0.txt"
      },
      {
        "from": "node_modules/@lancedb/lancedb/RUST_THIRD_PARTY_LICENSES.html",
        "to": "licenses/LanceDB-Rust-Third-Party.html"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/@huggingface/**/*",
      "!node_modules/@img/**/*",
      "!node_modules/onnxruntime-node/**/*",
      "!node_modules/onnxruntime-web/**/*",
      "!node_modules/sharp/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Pi-Desktop-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Pi-Desktop-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
