{
  "name": "pi-desktop-client",
  "version": "0.6.0",
  "private": true,
  "description": "A desktop Agent workspace powered by Pi RPC mode",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "verify:renderer": "node tests/integration/verify-renderer.cjs",
    "preview:workspace": "node tests/e2e/build-workspace-preview.mjs",
    "verify:themes": "npm run build && node tests/e2e/verify-workspace-theme.mjs",
    "verify:interview-ui": "npm run build && node tests/e2e/verify-interview-ui.mjs",
    "verify:pty": "electron tests/integration/verify-pty.cjs",
    "prepare:python:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-python-runtime.ps1",
    "dist:win": "npm run prepare:python:win && npm run build && npm run test:package-harness && npm run verify:renderer && electron-builder --win portable --x64",
    "dist:win:setup": "npm run prepare:python:win && npm run build && npm run test:package-harness && npm run verify:renderer && electron-builder --win nsis --x64",
    "verify:package": "node tests/integration/verify-packaged-runtime.cjs --runtime-only",
    "verify:portable": "node tests/integration/verify-packaged-runtime.cjs",
    "verify:knowledge-ui": "npm run build && node tests/e2e/verify-knowledge-ui.mjs",
    "verify:package-deps": "node tests/integration/verify-packaged-dependencies.cjs",
    "library:models": "node scripts/library-models/start.mjs",
    "test:unit": "node tests/run.mjs unit",
    "test:node": "node tests/run.mjs node",
    "test:integration": "node tests/run.mjs integration",
    "test:e2e": "node tests/run.mjs e2e",
    "test:python": "node tests/run.mjs python",
    "test:package-harness": "node tests/build-package-smoke.mjs",
    "capture:readme": "node tests/e2e/capture-readme.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "file:../pi-agent/packages/coding-agent",
    "@lancedb/lancedb": "^0.39.0",
    "@langchain/langgraph": "^1.4.17",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "^3.14.11",
    "@xmldom/xmldom": "^0.9.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "apache-arrow": "18.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "node-pty": "^1.1.0",
    "pdf-parse": "^2.4.5",
    "prismjs": "^1.30.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/lxgw-wenkai": "^5.3.0",
    "@fontsource/maple-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.9",
    "lucide-react": "^0.544.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.local.pidesktop",
    "productName": "Pi Desktop",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@earendil-works/pi-coding-agent/**/*",
      "node_modules/**/*.node"
    ],
    "extraResources": [
      {
        "from": "resources/desktop-pets",
        "to": "desktop-pets",
        "filter": ["**/*"]
      },
      {
        "from": "scripts/library-models",
        "to": "library-model-service",
        "filter": [
          "server.py",
          "manifest.json",
          "requirements.txt",
          "environment-win-cu124.txt",
          "setup.ps1",
          "download.py"
        ]
      },
      {
        "from": "resources/interview-question-bank",
        "to": "interview-question-bank",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/algorithm-practice",
        "to": "algorithm-practice",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@fontsource-variable/noto-sans-sc/LICENSE",
        "to": "licenses/Noto-Sans-SC-OFL.txt"
      },
      {
        "from": "node_modules/@fontsource/lxgw-wenkai/LICENSE",
        "to": "licenses/LXGW-WenKai-OFL.txt"
      },
      {
        "from": "node_modules/@fontsource-variable/jetbrains-mono/LICENSE",
        "to": "licenses/JetBrains-Mono-OFL.txt"
      },
      {
        "from": "node_modules/@fontsource/maple-mono/LICENSE",
        "to": "licenses/Maple-Mono-OFL.txt"
      },
      {
        "from": "node_modules/@lancedb/lancedb/license_header.txt",
        "to": "licenses/LanceDB-Apache-2.0.txt"
      },
      {
        "from": "node_modules/@lancedb/lancedb/RUST_THIRD_PARTY_LICENSES.html",
        "to": "licenses/LanceDB-Rust-Third-Party.html"
      },
      {
        "from": "node_modules/monaco-editor/LICENSE",
        "to": "licenses/Monaco-MIT.txt"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/@huggingface/**/*",
      "!node_modules/@img/**/*",
      "!node_modules/onnxruntime-node/**/*",
      "!node_modules/onnxruntime-web/**/*",
      "!node_modules/sharp/**/*",
      "!node_modules/**/*.map",
      "!node_modules/pdf-parse/dist/pdf-parse/web/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Pi-Desktop-${version}-${arch}.${ext}"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Pi-Desktop-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh-TW"
    ]
  }
}
